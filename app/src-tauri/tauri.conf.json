{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "envsetup",
  "version": "0.1.3",
  "identifier": "dev.envsetup.app",
  "build": {
    "beforeDevCommand": "npm run sidecar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "envsetup",
        "width": 1000,
        "height": 700,
        "minWidth": 420,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/envsetup"
    ],
    "resources": {
      "../../config/": "data/config/",
      "../../dotfiles/": "data/dotfiles/",
      "../../windows/": "data/windows/"
    }
  }
}
