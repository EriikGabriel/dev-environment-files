{
	"React Functional Component with Props Interface": {
		"prefix": "rc",
		"body": [
			"interface ${1:Component}Props {}",
			"",
			"export function ${1:Component}({}: ${1:Component}Props) {",
			"  return (",
			"    <div />",
			"  );",
			"}"
		],
		"description": "Creates a React functional component using a traditional function declaration"
	},
	"React Context Provider": {
		"prefix": "rctx",
		"body": [
			"import { createContext, type ReactNode, useContext, useState } from \"react\";",
			"",
			"type ${1:ContextName}ContextType = {",
			"  ${2:value}: ${3:string};",
			"  set${4:Value}: (value: ${3:string}) => void;",
			"};",
			"",
			"interface ${1:ContextName}ProviderProps {",
			"  children: ReactNode;",
			"}",
			"",
			"const ${1:ContextName}Context = createContext<${1:ContextName}ContextType | null>(null);",
			"",
			"export function ${1:ContextName}Provider({ children }: ${1:ContextName}ProviderProps) {",
			"  const [${2:value}, set${4:Value}] = useState<${3:string}>(${5:\"\"});",
			"",
			"  return (",
			"    <${1:ContextName}Context.Provider value={{ ${2:value}, set${4:Value} }}>",
			"      {children}",
			"    </${1:ContextName}Context.Provider>",
			"  );",
			"}",
			"",
			"export function use${1:ContextName}() {",
			"  const context = useContext(${1:ContextName}Context);",
			"",
			"  if (!context) {",
			"    throw new Error(\"use${1:ContextName} must be used within a ${1:ContextName}Provider\");",
			"  }",
			"",
			"  return context;",
			"}"
		],
		"description": "Creates a typed React Context with Provider and hook"
	}
}
